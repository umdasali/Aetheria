{
  "expo": {
    "name": "Aetheria: Legends Unbound",
    "slug": "aetheria-legends-unbound",
    "scheme": "aetheria",
    "version": "2.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "aetheria-legends.unbound",
      "buildNumber": "2",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#06030F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "aetheria_legends.unbound",
      "versionCode": 2,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "com.android.vending.BILLING"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "newArchEnabled": true
          },
          "android": {
            "newArchEnabled": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06030F",
          "image": "./assets/splash/splash-landscape.png",
          "resizeMode": "cover",
          "dark": {
            "backgroundColor": "#06030F",
            "image": "./assets/splash/splash-landscape.png"
          }
        }
      ],
      "expo-video",
      "expo-sharing",
      "expo-font",
      "expo-asset"
    ],
    "owner": "ziriverse",
    "extra": {
      "eas": {
        "projectId": "ce58691c-6e39-4fc7-b26e-2cecf1865ca7"
      }
    }
  }
}
