# Environment variables for Aetheria: Legends Unbound
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.
# These are read in app.config.js and exposed via Constants.expoConfig.extra.
# For EAS builds, set the same keys as EAS secrets, e.g.:
#   eas secret:create --name SUPABASE_URL --value "https://xxxx.supabase.co"

# Supabase (cloud save, auth, leaderboards). The anon key is safe for the
# client when Row Level Security is enabled (see supabase/migrations/0001_init.sql).
SUPABASE_URL=
SUPABASE_ANON_KEY=
